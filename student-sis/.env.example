# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=sisdb
POSTGRES_USER=sisuser
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# ─── JWT Secrets (generate with: openssl rand -hex 64) ───────────────────────
JWT_SECRET=CHANGE_THIS_64_CHAR_HEX_STRING
JWT_REFRESH_SECRET=CHANGE_THIS_DIFFERENT_64_CHAR_HEX_STRING

# ─── Invite Token Secret ──────────────────────────────────────────────────────
INVITE_SECRET=CHANGE_THIS_INVITE_SECRET

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=CHANGE_THIS_NEXTAUTH_SECRET

# ─── URLs ─────────────────────────────────────────────────────────────────────
# Development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# Production (replace with your actual domain)
# FRONTEND_URL=https://sis.yourschool.edu
# BACKEND_URL=https://sis.yourschool.edu

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Option 1: Gmail / Google Workspace SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=noreply@yourschool.edu
EMAIL_PASS=YOUR_GMAIL_APP_PASSWORD
EMAIL_FROM="EduSIS <noreply@yourschool.edu>"

# Option 2: SendGrid
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=YOUR_SENDGRID_API_KEY

# Option 3: AWS SES
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_USER=YOUR_AWS_SMTP_USER
# EMAIL_PASS=YOUR_AWS_SMTP_PASS

# ─── Google Workspace / OAuth 2.0 ────────────────────────────────────────────
# Create at: https://console.cloud.google.com/
# Enable APIs: Google Classroom API, Google Admin SDK, OAuth2
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
# Production callback URL (must match Google Cloud Console setting):
GOOGLE_REDIRECT_URI=https://sis.yourschool.edu/api/google/callback
# Development:
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback

# ─── Frontend Public Vars ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
NEXTAUTH_URL=http://localhost:3000
